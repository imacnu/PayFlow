  "strings": {
    "Abre Subscription Guardian al menos una vez para usar esta función.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Subscription Guardian at least once to use this feature."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Subscription Guardian al menos una vez para usar esta función."
          }
        }
      }
    },
